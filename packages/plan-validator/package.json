{
  "name": "@multipliers-dev/plan-validator",
  "version": "0.1.0",
  "description": "Deterministic structural validator for Cursor staged plan files (.cursor/plans)",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multipliers-dev/cursor-team-marketplace.git",
    "directory": "packages/plan-validator"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "bin": {
    "plan-validator": "./dist/plan-validator.mjs"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "prepack": "npm run build",
    "verify": "npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
