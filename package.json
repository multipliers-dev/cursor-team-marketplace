{
  "name": "cursor-team-marketplace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "check:agent-plugins-spec-drift": "tsx scripts/check-agent-plugins-spec-drift.ts",
    "validate:plans": "tsx plugins/team-harness/scripts/validate-plans.ts --allow-empty",
    "validate:plans:template": "tsx plugins/team-harness/scripts/validate-plans.ts --profile template plugins/team-harness/skills/planning-methodology/_template.plan.md",
    "build:validator": "tsx scripts/build-validator-bundle.ts",
    "check:validator-bundle-drift": "sh scripts/check-validator-bundle-drift.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "esbuild": "0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.0",
    "yaml": "^2.8.1"
  }
}
